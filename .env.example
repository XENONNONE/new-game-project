# GestureLSM Avatar Runtime Environment Variables
# Copy to .env and customize. Environment variables override config.yaml values.

# Server
AVATAR_HOST=0.0.0.0
AVATAR_PORT=8765
AVATAR_THREADS=6
AVATAR_SERVER_RATE_LIMIT_PER_MINUTE=60
AVATAR_SERVER_ENABLE_METRICS=1
AVATAR_SERVER_ENABLE_HEALTH_DETAILS=1
AVATAR_SERVER_CORS_ORIGINS=
AVATAR_SERVER_REQUEST_TIMEOUT=300.0
AVATAR_SERVER_MAX_REQUEST_BYTES=33554432
AVATAR_SERVER_MAX_CHAT_BYTES=1048576

# Pipeline
AVATAR_PIPELINE_MODEL_NAME=meanflow
AVATAR_PIPELINE_THREADS=6
AVATAR_PIPELINE_SEED=42
AVATAR_PIPELINE_CACHE_INFER_TEST=1
AVATAR_PIPELINE_TORCH_COMPILE=0
AVATAR_PIPELINE_USE_ONNX=1  # enable ONNX Runtime for MeanFlow denoiser (~11x speedup)

# LLM (Qwen via llama.cpp server)
AVATAR_LLM_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions
AVATAR_LLM_MODEL=local-qwen
AVATAR_LLM_TIMEOUT=120.0
AVATAR_LLM_MAX_RETRIES=3
AVATAR_LLM_RETRY_BACKOFF=1.5
AVATAR_LLM_CIRCUIT_BREAKER_FAILURES=5
AVATAR_LLM_CIRCUIT_BREAKER_TIMEOUT=30.0

# TTS
AVATAR_TTS_BACKEND=kitten
AVATAR_TTS_KOKORO_DIR=
AVATAR_TTS_VOICE=
AVATAR_TTS_LANG=a
AVATAR_TTS_COMMAND=
AVATAR_TTS_TIMEOUT=120
AVATAR_TTS_MAX_RETRIES=2
AVATAR_TTS_RETRY_BACKOFF=1.5

# Logging
AVATAR_LOG_LEVEL=INFO
AVATAR_LOG_FILE=
AVATAR_LOG_JSON=0

# Environment
AVATAR_ENVIRONMENT=production
AVATAR_CONFIG=
